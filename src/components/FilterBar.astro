---
import { KATEGORIEN } from '../lib/kategorien';
import { BEREICHE } from '../lib/bereiche';
import { bundeslandLabel } from '../lib/bundeslaender';

interface Props {
  /** Kategorie-Counts — nur Kategorien mit >=1 Werkzeug zeigen */
  counts: Record<string, number>;
  /** vorhandene Bereiche, in Anzeige-Reihenfolge */
  bereiche: string[];
  /** vorhandene Bundesland-Codes (leer = kein Bundesland-Filter) */
  bundeslaender: string[];
}

const { counts, bereiche, bundeslaender } = Astro.props as Props;
const aktiveKategorien = Object.entries(KATEGORIEN).filter(([id]) => (counts[id] ?? 0) > 0);
const aktiveBereiche = bereiche.filter((id) => BEREICHE[id]);
---
{/*
  Single-Select: ueber alle Gruppen hinweg ist immer nur EIN Filter aktiv
  (Highlights / Alle / ein Bereich / eine Kategorie / ein Bundesland). Ein Klick
  ersetzt die vorige Auswahl — keine Kombinationen, damit es nicht kompliziert
  wird. Jeder Chip traegt seinen Facetten-Typ in data-facet.
*/}
<div class="filter-bar" data-filter-bar>
  <span class="filter-bar__label">Ansicht:</span>
  <div class="filter-bar__group">
    <button class="filter-chip" type="button" data-facet="highlights" data-value="" aria-pressed="false">Highlights</button>
    <button class="filter-chip" type="button" data-facet="all" data-value="" aria-pressed="true">Alle</button>
  </div>

  {aktiveBereiche.length > 0 && (
    <>
      <span class="filter-bar__label" style="margin-left:1rem;">Bereich:</span>
      <div class="filter-bar__group">
        {aktiveBereiche.map((id) => (
          <button class="filter-chip" type="button" data-facet="bereich" data-value={id} aria-pressed="false">{BEREICHE[id]}</button>
        ))}
      </div>
    </>
  )}

  {aktiveKategorien.length > 0 && (
    <>
      <span class="filter-bar__label" style="margin-left:1rem;">Kategorie:</span>
      <div class="filter-bar__group">
        {aktiveKategorien.map(([id, label]) => (
          <button class="filter-chip" type="button" data-facet="category" data-value={id} aria-pressed="false">{label}</button>
        ))}
      </div>
    </>
  )}

  {bundeslaender.length > 0 && (
    <>
      <span class="filter-bar__label" style="margin-left:1rem;">Bundesland:</span>
      <div class="filter-bar__group">
        {bundeslaender.map((code) => (
          <button class="filter-chip" type="button" data-facet="bundesland" data-value={code} aria-pressed="false">{bundeslandLabel(code)}</button>
        ))}
      </div>
    </>
  )}
</div>

<script>
  (function () {
    const bar = document.querySelector('[data-filter-bar]') as HTMLElement | null;
    if (!bar) return;
    // Genau ein aktiver Filter (Facette + Wert). Default: Alle.
    const state = { facet: 'all', value: '' };

    function applyFilters() {
      const cards = document.querySelectorAll('.werkzeug-card[data-bereich]');
      cards.forEach((card) => {
        const el = card as HTMLElement;
        const bereich = el.dataset.bereich || '';
        const cats = (el.dataset.categories || '').split(',').filter(Boolean);
        const bls = (el.dataset.bundesland || '').split(',').filter(Boolean);

        let show = true;
        switch (state.facet) {
          case 'highlights':
            // Per-Tool-Override (data-highlight) sticht den bereichsbasierten
            // Default; die Card hat das bereits aufgeloest.
            show = el.dataset.highlight === 'true';
            break;
          case 'all':
            show = true;
            break;
          case 'bereich':
            show = bereich === state.value;
            break;
          case 'category':
            show = cats.includes(state.value);
            break;
          case 'bundesland':
            // Exklusiv: nur Tools dieses Bundeslands (bundesweite ausgeblendet).
            show = bls.includes(state.value);
            break;
        }
        el.style.display = show ? '' : 'none';
      });
    }

    // Single-Select ueber ALLE Gruppen: ein Klick loescht jede andere Auswahl.
    bar.querySelectorAll('button.filter-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        bar.querySelectorAll('button.filter-chip').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        const el = btn as HTMLElement;
        state.facet = el.dataset.facet || 'all';
        state.value = el.dataset.value || '';
        applyFilters();
      });
    });

    // Default-Alle-Ansicht sofort anwenden (ohne JS bleiben alle sichtbar).
    applyFilters();
  })();
</script>
