---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WerkzeugCard from '../components/WerkzeugCard.astro';
import FilterBar from '../components/FilterBar.astro';

const all = await getCollection('werkzeuge');
const sorted = [...all].sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'));

const counts: Record<string, number> = {};
for (const e of all) {
  for (const c of e.data.categories) {
    counts[c] = (counts[c] ?? 0) + 1;
  }
}
---
<Base title="Werkzeuge" description="Werkzeug-Verzeichnis fuer Gruene-Gemeindegruppen — eigene Tools und kuratierte Dritt-Tools, filterbar nach Typ und Kategorie.">
  <section class="werkzeuge-hero">
    <h1>Werkzeuge fuer Gemeindegruppen</h1>
    <p>
      Eine kuratierte Sammlung digitaler Werkzeuge fuer Gruene-Gemeindegruppen
      und kommunalpolitische Arbeit. Filtere unten nach Typ oder Kategorie —
      oder sieh dir das nach Themen geordnete
      <a href={`${import.meta.env.BASE_URL}verzeichnis/`}>Verzeichnis</a> an.
    </p>
  </section>

  <p>{sorted.length} Werkzeuge insgesamt. Filtere nach Typ oder Kategorie.</p>

  <FilterBar counts={counts} />

  <div class="werkzeug-liste">
    {sorted.map((e) => <WerkzeugCard entry={e} />)}
  </div>
</Base>
